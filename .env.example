# Photo providers — at least one key is required. Pages show an error state
# when no provider is configured or the provider is unreachable.

# Unsplash Access Key — https://unsplash.com/developers
VITE_UNSPLASH_ACCESS_KEY=

# Pexels API Key — https://www.pexels.com/api/
VITE_PEXELS_API_KEY=

# Firebase Auth — https://console.firebase.google.com
# 1. Create a project and register a Web app, then copy its config here.
# 2. Enable the sign-in providers: Authentication → Sign-in method →
#    Google (with support email) and Email/Password.
# 3. Sign-in works on localhost out of the box; add your production domain
#    under Authentication → Settings → Authorized domains when you deploy.
# Optional extras: VITE_FIREBASE_STORAGE_BUCKET, VITE_FIREBASE_MESSAGING_SENDER_ID
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
